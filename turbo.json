{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "env": ["NEXT_TELEMETRY_DISABLED"],
            "outputs": [".next/**", "!.next/cache/**", ".output/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        }
    }
}
