{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "plugins": [{ "name": "next" }],
        "paths": {
            "@components/*": ["./src/components/*"],
            "@lib/*": ["./src/lib/*"]
        }
    },
    "include": ["next-env.d.ts", "src", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "next.config.ts"],
    "exclude": ["node_modules"]
}
