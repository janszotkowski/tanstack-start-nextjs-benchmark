{
    "name": "tanstack-start-nextjs-benchmark",
    "version": "0.0.0",
    "private": true,
    "description": "Next.js vs TanStack Start: same UI, same data, only the framework differs",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "typecheck": "turbo run typecheck",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "policy": "node tools/check-policy.js",
        "verify": "pnpm policy && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm bench:smoke",
        "bench:smoke": "node scripts/smoke.js",
        "bench:build": "node scripts/build.js",
        "bench:bundle": "node scripts/bundle.js",
        "bench:load": "node scripts/load.js",
        "bench:lighthouse": "node scripts/lighthouse.js",
        "bench:dev": "node scripts/dev.js",
        "bench:docker": "node scripts/docker.js",
        "bench:report": "node scripts/report.js",
        "bench:all": "pnpm bench:build && pnpm bench:bundle && pnpm bench:dev && pnpm bench:docker && pnpm bench:load && pnpm bench:lighthouse && pnpm bench:report"
    },
    "devDependencies": {
        "@types/node": "26.6.5",
        "autocannon": "8.0.0",
        "chrome-launcher": "1.2.2",
        "lighthouse": "13.5.0",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "puppeteer-core": "25.15.0",
        "turbo": "2.11.9",
        "typescript": "7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.22.1",
            "onFail": "error"
        }
    },
    "packageManager": "pnpm@12.14.0"
}
